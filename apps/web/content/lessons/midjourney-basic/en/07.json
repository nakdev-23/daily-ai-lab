      {
        "text": " across many images, use "
      },
      {
        "text": "--cref [character image link]",
        "bold": true
      },
      {
        "text": ". Great for keeping a brand mascot/character consistent across many scenes."
      }
    ],
    "example": "the same mascot character riding a bike --cref [mascot image link]",
